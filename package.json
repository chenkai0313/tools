{
  "name": "tools",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && rm -rf docs && cp -r out docs && touch docs/.nojekyll && for d in out docs; do find \"$d\" -name index.html -not -path \"$d/index.html\" | while read f; do dir=$(dirname \"$f\"); parent=$(dirname \"$dir\"); name=$(basename \"$dir\"); cp \"$f\" \"${parent}/${name}.html\"; done; done",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "crypto-js": "^4.2.0",
    "js-yaml": "^4.1.1",
    "next": "16.2.4",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "smol-toml": "^1.6.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/crypto-js": "^4.2.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
